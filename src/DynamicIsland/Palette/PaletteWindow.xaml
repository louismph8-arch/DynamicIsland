<Window x:Class="DynamicIsland.Palette.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
        Title="{ui:L palette.opaline_palette}"
        Width="720" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}">

  <!-- La carte part de la taille de l'île (même place, même arrondi) et s'agrandit : la palette « sort » de l'île. -->
  <!-- L'ombre est sur ce conteneur : l'effet de la carte elle-même est le verre liquide. -->
  <!-- Alignements changés par le code selon la place de l'île : la carte grandit vers l'intérieur de l'écran. -->
  <Grid x:Name="CardHost" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Grid.Effect>
      <DropShadowEffect x:Name="CardShadow" Direction="{x:Static t:Shadows.Direction}" RenderingBias="Performance"/>
    </Grid.Effect>
  <ui:SquircleBorder x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{ui:Space 0,s4,0,0}"
          Width="124" Height="36" CornerRadius="{x:Static t:Corners.XXL}" BorderThickness="{x:Static t:Borders.Hairline}" Background="{DynamicResource IslandBrush}">
    <Grid x:Name="ClipHost">
      <StackPanel x:Name="CardContent" Width="{x:Static t:Sizes.PaletteWidth}" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
        <Grid x:Name="Header" Height="58" Margin="{ui:Space s10,0}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static t:Icons.Search}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XL}"
                     Foreground="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="{ui:Space s7,0,0,0}" VerticalAlignment="Center" FontSize="{x:Static t:TypeRamp.Title2}"
                     Foreground="{StaticResource TextTertiary}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                     Text="{ui:L palette.apps_dossiers_15_80}"/>
          <TextBox x:Name="QueryBox" Grid.Column="1" Margin="{ui:Space s5,0,0,0}" VerticalAlignment="Center" FontSize="{x:Static t:TypeRamp.Title2}"
                   Background="Transparent" BorderThickness="{x:Static t:Borders.None}" Foreground="{StaticResource TextPrimary}"
                   CaretBrush="{x:Static t:Paint.White}" SelectionBrush="{DynamicResource AccentBrush}"
                   TextChanged="QueryBox_TextChanged"/>
        </Grid>
        <Border Height="1" Background="{StaticResource DividerBrush}"/>
        <ScrollViewer x:Name="Scroller" MaxHeight="392" Margin="{ui:Space s4,s3,s4,0}"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Results"/>
        </ScrollViewer>
        <TextBlock x:Name="Footer" Text="{ui:L palette.choisir_entree_valider_echap}" FontSize="{x:Static t:TypeRamp.Caption}"
                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="{ui:Space 0,s3,0,s5}"/>
      </StackPanel>
    </Grid>
  </ui:SquircleBorder>
  </Grid>
</Window>
