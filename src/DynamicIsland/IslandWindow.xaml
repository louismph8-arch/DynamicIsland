<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        xmlns:a="clr-namespace:DynamicIsland.Animation"
        xmlns:tiles="clr-namespace:DynamicIsland.Tiles"
        Title="Dynamic Island"
        Width="600" Height="340" Left="0" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Paint.TextPrimary}"
        UseLayoutRounding="True">

  <!-- La fenêtre est fixe et transparente (les clics passent à travers) ;
       seule l'île (Border « Island ») change de taille, animée par un ressort. -->
  <!-- Taille de l'île (point 12) : tout le contenu est agrandi / réduit ici, la fenêtre suit (ApplyScale). -->
  <Grid x:Name="WindowRoot">
    <!-- Placement (bord haut / bas, gauche / centre / droite) appliqué par le code : l'île s'ouvre vers l'intérieur de l'écran. -->
    <Grid x:Name="HoverRoot" HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseEnter="HoverRoot_MouseEnter" MouseLeave="HoverRoot_MouseLeave"
          PreviewMouseLeftButtonDown="HoverRoot_PreviewMouseLeftButtonDown"
          MouseLeftButtonDown="HoverRoot_MouseLeftButtonDown" MouseMove="HoverRoot_MouseMove"
          MouseLeftButtonUp="HoverRoot_MouseLeftButtonUp" LostMouseCapture="HoverRoot_LostMouseCapture"
          AllowDrop="True" DragEnter="HoverRoot_DragEnter" DragOver="HoverRoot_DragOver"
          DragLeave="HoverRoot_DragLeave" Drop="HoverRoot_Drop">
      <Grid.ContextMenu>
        <ContextMenu Opened="IslandMenu_Opened">
          <MenuItem x:Name="ResetPlaceItem" Header="{ui:L island.remettre_ile_haut_centre}" Click="ResetPlace_Click"/>
          <MenuItem x:Name="LockPlaceItem" Header="{ui:L island.verrouiller_position}" IsCheckable="True" Click="LockPlace_Click"/>
          <MenuItem Header="{ui:L island.parametres_ile}" Click="IslandSettings_Click"/>
          <Separator/>
          <MenuItem Header="{ui:L island.quitter_opaline}" Click="Quit_Click"/>
        </ContextMenu>
      </Grid.ContextMenu>

      <!-- Bande quasi invisible côté bord de l'écran : un curseur collé au bord ouvre aussi l'île. -->
      <Border x:Name="EdgeBand" Height="10" VerticalAlignment="Top" Background="{x:Static t:Paint.HitTarget}"/>

      <!-- Conteneur de l'île (transformations « pour le fun »). L'effet de l'île elle-même est le verre liquide. -->
      <Grid x:Name="IslandShell" VerticalAlignment="Top">
        <!-- Halo / ombre : élément FRÈRE sous l'île, même forme, découpé hors de l'intérieur de l'île et gardé en image
             (BitmapCache) quand la forme ne bouge plus (UpdateHaloClip). Avant, le DropShadowEffect était sur ce conteneur :
             chaque image de la lumière qui suit la souris refaisait le flou de toute l'île + 38 DIP autour. Maintenant il
             n'est refait que si la taille, l'arrondi ou la couleur du halo changent. -->
        <Grid x:Name="HaloCache" IsHitTestVisible="False"
              Width="{Binding Width, ElementName=Island}" Height="{Binding Height, ElementName=Island}"
              Margin="{Binding Margin, ElementName=Island}" VerticalAlignment="{Binding VerticalAlignment, ElementName=Island}">
          <Grid x:Name="HaloHost">
            <ui:SquircleBorder x:Name="HaloShape" CornerRadius="{Binding CornerRadius, ElementName=Island}" Background="{x:Static t:Paint.HaloSource}">
              <ui:SquircleBorder.Effect>
                <DropShadowEffect x:Name="IslandShadow" Direction="{x:Static t:Shadows.Direction}" RenderingBias="Performance"/>
              </ui:SquircleBorder.Effect>
            </ui:SquircleBorder>
          </Grid>
        </Grid>
      <ui:SquircleBorder x:Name="Island" Margin="{ui:Space 0,s4,0,0}" VerticalAlignment="Top"
              Width="124" Height="36" CornerRadius="{x:Static t:Corners.XXL}" BorderThickness="{x:Static t:Borders.Hairline}"
              Background="{DynamicResource IslandBrush}">

        <Grid x:Name="IslandContent">

          <!-- ===== Vue compacte (O5) : au repos l'heure seule ; une activité en direct (minuteur, transfert, installation,
               assistant, musique, vocal…) ajoute un bord gauche (anneau / pochette / avatars) et un bord droit (valeur /
               égaliseur / « +1 »). La pilule prend la largeur de son contenu (LivePill.Width), l'heure reste au centre. ===== -->
          <Grid x:Name="CompactView">
            <Grid x:Name="LiveLeading" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0">
              <ui:SquircleBorder x:Name="CompactArt" Width="{x:Static t:IslandShape.LiveArt}" Height="{x:Static t:IslandShape.LiveArt}" CornerRadius="{x:Static t:Corners.S}"
                      VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
              <!-- Salon vocal Discord : avatars (anneau vert = parle) -->
              <StackPanel x:Name="VoiceAvatars" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>
              <!-- Anneau de progression (indéterminée = un arc qui tourne doucement) avec l'icône de l'activité au centre -->
              <Grid x:Name="LiveRing" Width="{x:Static t:IslandShape.LiveRing}" Height="{x:Static t:IslandShape.LiveRing}" VerticalAlignment="Center" Visibility="Collapsed">
                <Ellipse Stroke="{DynamicResource Paint.Track}" StrokeThickness="{x:Static t:Stroke.Focus}"/>
                <Path x:Name="LiveArc" StrokeThickness="{x:Static t:Stroke.Focus}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform><RotateTransform x:Name="LiveArcTurn"/></Path.RenderTransform>
                </Path>
                <TextBlock x:Name="LiveIcon" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XS}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Paint.TextSecondary}"/>
              </Grid>
            </Grid>

            <StackPanel x:Name="CompactCenter" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
              <!-- « Ne pas déranger » actif (7F) : petite lune discrète devant l'heure -->
              <TextBlock x:Name="FocusMoon" Text="{x:Static t:Icons.DoNotDisturb}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XS}"
                         Foreground="{DynamicResource Paint.TextTertiary}" VerticalAlignment="Center" Margin="{ui:Space 0,px,s3,0}" Visibility="Collapsed"/>
              <TextBlock x:Name="CompactClock" Style="{StaticResource Text.Numbers}" FontSize="{x:Static t:TypeRamp.Headline}" VerticalAlignment="Center"/>
              <!-- Confidentialité : vert = webcam utilisée, orange = micro (petits points discrets, regroupés) -->
              <StackPanel x:Name="PrivacyDots" Orientation="Vertical" VerticalAlignment="Center" Margin="{ui:Space s3,0,0,0}" Visibility="Collapsed">
                <Ellipse x:Name="CameraDot" Width="5" Height="5" Margin="{ui:Space 0,px}" Fill="{StaticResource CameraBrush}" Visibility="Collapsed"/>
                <Ellipse x:Name="MicDot" Width="5" Height="5" Margin="{ui:Space 0,px}" Fill="{StaticResource MicrophoneBrush}" Visibility="Collapsed"/>
              </StackPanel>
              <!-- Batterie : SEULEMENT si le PC en a une (BatteryFlag ≠ 128 / 255) -->
              <StackPanel x:Name="CompactBattery" Orientation="Horizontal" VerticalAlignment="Center" Margin="{ui:Space s4,0,0,0}" Visibility="Collapsed">
                <TextBlock x:Name="BatteryIcon" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.S}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Paint.TextSecondary}"/>
                <TextBlock x:Name="BatteryText" Style="{StaticResource Text.Numbers}" FontSize="{x:Static t:TypeRamp.Caption}" VerticalAlignment="Center"
                           Margin="{ui:Space s1,0,0,0}" Foreground="{DynamicResource Paint.TextSecondary}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="LiveTrailing" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Opacity="0">
              <StackPanel x:Name="Bars" Orientation="Horizontal" Height="14" VerticalAlignment="Center" Visibility="Collapsed">
                <Rectangle Width="3" Height="14" Margin="{ui:Space px,0}" RadiusX="{x:Static t:Radius.Marker}" RadiusY="{x:Static t:Radius.Marker}"
                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                  <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="3" Height="14" Margin="{ui:Space px,0}" RadiusX="{x:Static t:Radius.Marker}" RadiusY="{x:Static t:Radius.Marker}"
                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                  <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="3" Height="14" Margin="{ui:Space px,0}" RadiusX="{x:Static t:Radius.Marker}" RadiusY="{x:Static t:Radius.Marker}"
                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                  <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="3" Height="14" Margin="{ui:Space px,0}" RadiusX="{x:Static t:Radius.Marker}" RadiusY="{x:Static t:Radius.Marker}"
                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                  <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
                </Rectangle>
              </StackPanel>
              <TextBlock x:Name="LiveValue" Style="{StaticResource Text.Numbers}" FontSize="{x:Static t:TypeRamp.Body}" VerticalAlignment="Center" Visibility="Collapsed"/>
              <!-- Autres activités en cours : « +1 » -->
              <ui:SquircleBorder x:Name="LiveMore" CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource Paint.Track}" VerticalAlignment="Center"
                                 Padding="{ui:Space s2,0}" Margin="{ui:Space s3,0,0,0}" Visibility="Collapsed">
                <TextBlock x:Name="LiveMoreText" Style="{StaticResource Text.Numbers}" FontSize="{x:Static t:TypeRamp.Micro}" Foreground="{DynamicResource Paint.TextSecondary}"/>
              </ui:SquircleBorder>
            </StackPanel>
          </Grid>

          <!-- ===== Volume : s'affiche quelques instants quand il change ===== -->
          <Grid x:Name="VolumeHud" Opacity="0" IsHitTestVisible="False" Margin="{ui:Space s7,0}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HudIcon" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.M}" VerticalAlignment="Center"/>
            <ui:SquircleBorder Grid.Column="1" Height="5" CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource Paint.Track}" Margin="{ui:Space s5,0}" VerticalAlignment="Center">
              <ui:SquircleBorder CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource Paint.TextPrimary}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="HudScale" ScaleX="0.5"/></Border.RenderTransform>
              </ui:SquircleBorder>
            </ui:SquircleBorder>
            <TextBlock x:Name="HudText" Grid.Column="2" Style="{StaticResource Text.Numbers}" FontSize="{x:Static t:TypeRamp.Callout}" VerticalAlignment="Center"
                       MinWidth="34" TextAlignment="Right"/>
          </Grid>

          <!-- ===== Annonce (mise à jour, thème installé…) : quelques secondes, clic = action ===== -->
          <Grid x:Name="Notice" Opacity="0" IsHitTestVisible="False" Margin="{ui:Space s7,0}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeIcon" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.M}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentGradientBrush}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}">
              <TextBlock x:Name="NoticeText" FontSize="{x:Static t:TypeRamp.Callout}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <!-- 2e ligne facultative (appareil connecté : batterie…) -->
              <TextBlock x:Name="NoticeDetail" FontSize="{x:Static t:TypeRamp.Caption}" Foreground="{DynamicResource Paint.TextSecondary}"
                         TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>

          <!-- ===== Vue étendue : onglets ===== -->
          <Grid x:Name="ExpandedView" HorizontalAlignment="Center" VerticalAlignment="Top" Height="290"
                Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="ExpandedScale" ScaleX="0.92" ScaleY="0.92"/>
            </Grid.RenderTransform>

            <Grid x:Name="ExpandedLayout" Margin="{ui:Space s8,s5,s8,s8}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="32"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- En haut : onglets (défilants s'ils sont trop nombreux) puis l'heure ; en colonne, les onglets passent à gauche (point 12) -->
              <Grid x:Name="HeaderRow" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
              <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                            Focusable="False" PreviewMouseWheel="TabScroller_PreviewMouseWheel">
                <ScrollViewer.Resources>
                  <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                </ScrollViewer.Resources>
              <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="MusicTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Music}"
                             Content="{ui:L island.musique}" Checked="Tab_Checked"/>
                <RadioButton x:Name="CalendarTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Calendar}"
                             Content="{ui:L island.calendrier}" Checked="Tab_Checked"/>
                <RadioButton x:Name="ControlTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Controls}"
                             Content="{ui:L island.controles}" Checked="Tab_Checked"/>
                <RadioButton x:Name="WidgetsTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Widgets}"
                             Content="{ui:L island.widgets}" Checked="Tab_Checked"/>
                <RadioButton x:Name="ShelfTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Shelf}"
                             Content="{ui:L island.etagere}" Checked="Tab_Checked"/>
                <RadioButton x:Name="VoiceTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Voice}"
                             Content="{ui:L island.vocal}" Checked="Tab_Checked"/>
                <RadioButton x:Name="ClaudeTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Sparkles}"
                             Content="Claude" Checked="Tab_Checked"/>
                <RadioButton x:Name="ClocksTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Clock}"
                             Content="{ui:L island.clocks}" Checked="Tab_Checked"/>
                <RadioButton x:Name="HealthTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Health}"
                             Content="{ui:L island.health}" Checked="Tab_Checked"/>
                <RadioButton x:Name="MixerTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Mixer}"
                             Content="{ui:L island.mixer}" Checked="Tab_Checked"/>
                <RadioButton x:Name="FriendsTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Friends}"
                             Content="{ui:L island.friends}" Checked="Tab_Checked" Visibility="Collapsed"/>
                <RadioButton x:Name="ClipboardTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Clipboard}"
                             Content="{ui:L island.clipboard}" Checked="Tab_Checked"/>
                <RadioButton x:Name="NotesTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Notes}"
                             Content="{ui:L island.notes}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TranslateTabButton" Style="{StaticResource TabButton}" Tag="{x:Static t:Icons.Translate}"
                             Content="{ui:L island.translate}" Checked="Tab_Checked"/>
              </StackPanel>
              </ScrollViewer>
              <!-- Grille de tuiles (O6) : la date au repos, « ← Nom » quand un outil est ouvert (retour à la grille) -->
              <Grid x:Name="GridHeader" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="GridDate" VerticalAlignment="Center" Margin="{ui:Space s2,0,0,0}" FontSize="{x:Static t:TypeRamp.Callout}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Paint.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BackButton" Style="{StaticResource ChipButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                        Click="BackButton_Click" ToolTip="{ui:L tiles.back}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static t:Icons.ChevronLeft}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.M}" VerticalAlignment="Center"
                               Margin="{ui:Space -s1,0,0,0}"/>
                    <TextBlock x:Name="BackTitle" VerticalAlignment="Center" Margin="{ui:Space s2,0,s1,0}"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock x:Name="TabTitle" VerticalAlignment="Center" Visibility="Collapsed" Margin="{ui:Space s2,0,0,0}"
                         FontSize="{x:Static t:TypeRamp.Callout}" FontWeight="SemiBold"/>
              <StackPanel x:Name="HeaderRight" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="{ui:Space s4,0,s2,0}">
                <Ellipse x:Name="ExpandedCameraDot" Width="6" Height="6" Margin="{ui:Space 0,0,s3,0}" VerticalAlignment="Center"
                         Fill="{StaticResource CameraBrush}" Visibility="Collapsed"/>
                <Ellipse x:Name="ExpandedMicDot" Width="6" Height="6" Margin="{ui:Space 0,0,s4,0}" VerticalAlignment="Center"
                         Fill="{StaticResource MicrophoneBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="ExpandedFocusMoon" Text="{x:Static t:Icons.DoNotDisturb}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.S}"
                           Foreground="{DynamicResource Paint.TextSecondary}" VerticalAlignment="Center" Margin="{ui:Space 0,px,s3,0}" Visibility="Collapsed"/>
                <TextBlock x:Name="ExpandedClock" Style="{StaticResource Text.Numbers}" FontSize="{x:Static t:TypeRamp.Headline}" VerticalAlignment="Center"/>
              </StackPanel>
              </Grid>

              <!-- Pages des onglets (O3 : elles glissent d'une page à l'autre ; découpées seulement pendant le glissement) -->
              <Grid x:Name="TabPages" Grid.Row="1" Grid.Column="1" Margin="{ui:Space 0,s4,0,0}">
                <views:MusicView x:Name="MusicTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:CalendarTimerView x:Name="CalendarTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:ControlCenterView x:Name="ControlTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:WidgetsView x:Name="WidgetsTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:ShelfView x:Name="ShelfTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:VoiceView x:Name="VoiceTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:ClaudeView x:Name="ClaudeTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:WorldClockView x:Name="ClocksTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:HealthView x:Name="HealthTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:MixerView x:Name="MixerTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:FriendsView x:Name="FriendsTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:ClipboardView x:Name="ClipboardTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:NotesView x:Name="NotesTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:TranslateView x:Name="TranslateTab" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <!-- Grille de tuiles (O6) : l'accueil de l'île ; les onglets ci-dessus deviennent les vues détaillées (outils) -->
                <tiles:TileGridView x:Name="TileGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"/>
              </Grid>
            </Grid>
          </Grid>

          <!-- Mouvement (O3) : reflet qui suit le curseur sur une tuile, tuile qui s'agrandit en outil (non cliquable) -->
          <Canvas x:Name="MotionCanvas" IsHitTestVisible="False" a:MotionLayer.IsHost="True"/>

          <!-- Pour le fun (6F) : neige, fantômes, confettis, cœurs par-dessus l'île -->
          <ui:SeasonEffect x:Name="SeasonLayer"/>

        </Grid>
      </ui:SquircleBorder>
      </Grid>
    </Grid>
  </Grid>
</Window>
