<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- La version Windows dans le TFM donne accÃ¨s aux API WinRT (contrÃ´les mÃ©dia). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- ManagedShell (zone de notification) utilise System.Windows.Forms : sans Ã§a, la version publiÃ©e
         (autonome) ne l'embarque pas et l'arrÃªt de la zone de notification Ã©choue. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 vise les apps WinForms (DPI via Application.SetHighDpiMode) : le manifeste reste la bonne place pour WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Nom affichÃ© (5H) ; l'exe et les dossiers gardent Â« DynamicIsland Â» (voir AppInfo.cs). -->
    <Product>Opaline</Product>
    <AssemblyTitle>Opaline</AssemblyTitle>
    <Version>1.32.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <!-- Pas de Â« using Â» implicite de WinForms : ses types (Application, Buttonâ€¦) entreraient en conflit avec WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- IcÃ´nes de l'interface : police Lucide (licence ISC, copiÃ©e Ã  cÃ´tÃ© de l'exe) -->
    <Resource Include="Assets\Fonts\lucide.ttf" />
    <!-- Verre liquide : shader compilÃ© par tools\compile-shaders.ps1 (la source .fx reste Ã  cÃ´tÃ©) -->
    <Resource Include="Themes\Shaders\LiquidGlass.ps" />
    <Resource Include="Themes\Shaders\AnimatedAurora.ps" />
    <None Include="Assets\Fonts\LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fichiers de langue (6A) : clÃ© â†’ texte, lus par Loc -->
    <EmbeddedResource Include="Localization\fr.json" LogicalName="DynamicIsland.Localization.fr.json" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="DynamicIsland.Localization.en.json" />
    <!-- Page du tÃ©lÃ©phone pour la tÃ©lÃ©commande (6D), servie par Services/Remote -->
    <EmbeddedResource Include="Services\Remote\RemotePage.html" LogicalName="DynamicIsland.Remote.RemotePage.html" />
    <!-- Code du serveur Â« Amis en ligne Â» (6D-4), copiÃ© depuis les paramÃ¨tres pour Ãªtre collÃ© dans Cloudflare -->
    <EmbeddedResource Include="..\..\server\amis\worker.js" LogicalName="DynamicIsland.Friends.worker.js" />
    <!-- Ã‰cran Â« NouveautÃ©s Â» (7C) : notes de CETTE version (notes/vX.Y.Z.md, et .en.md en anglais s'il existe) -->
