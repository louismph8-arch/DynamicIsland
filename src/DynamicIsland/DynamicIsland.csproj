<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- La version Windows dans le TFM donne accès aux API WinRT (contrôles média). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- ManagedShell (zone de notification) utilise System.Windows.Forms : sans ça, la version publiée
         (autonome) ne l'embarque pas et l'arrêt de la zone de notification échoue. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 vise les apps WinForms (DPI via Application.SetHighDpiMode) : le manifeste reste la bonne place pour WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Nom affiché (5H) ; l'exe et les dossiers gardent « DynamicIsland » (voir AppInfo.cs). -->
    <Product>Opaline</Product>
    <AssemblyTitle>Opaline</AssemblyTitle>
    <Version>1.23.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <!-- Pas de « using » implicite de WinForms : ses types (Application, Button…) entreraient en conflit avec WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Icônes de l'interface : police Lucide (licence ISC, copiée à côté de l'exe) -->
    <Resource Include="Assets\Fonts\lucide.ttf" />
    <!-- Verre liquide : shader compilé par tools\compile-shaders.ps1 (la source .fx reste à côté) -->
    <Resource Include="Themes\Shaders\LiquidGlass.ps" />
    <Resource Include="Themes\Shaders\AnimatedAurora.ps" />
    <None Include="Assets\Fonts\LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fichiers de langue (6A) : clé → texte, lus par Loc -->
    <EmbeddedResource Include="Localization\fr.json" LogicalName="DynamicIsland.Localization.fr.json" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="DynamicIsland.Localization.en.json" />
    <!-- Page du téléphone pour la télécommande (6D), servie par Services/Remote -->
    <EmbeddedResource Include="Services\Remote\RemotePage.html" LogicalName="DynamicIsland.Remote.RemotePage.html" />
    <!-- Code du serveur « Amis en ligne » (6D-4), copié depuis les paramètres pour être collé dans Cloudflare -->
    <EmbeddedResource Include="..\..\server\amis\worker.js" LogicalName="DynamicIsland.Friends.worker.js" />
  </ItemGroup>

</Project>
