    <EmbeddedResource Include="..\..\notes\v$(Version).en.md" LogicalName="DynamicIsland.WhatsNew.en.md" WithCulture="false" Condition="Exists('..\..\notes\v$(Version).en.md')" />
    <!-- Widgets des potes (7H) : modele, exemples et doc copies par Creer un widget -->
