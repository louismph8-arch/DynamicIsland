<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:DynamicIsland.Themes"
                    xmlns:ui="clr-namespace:DynamicIsland.Controls">

  <!-- Bouton de navigation (colonne de gauche) : icône (Tag) + libellé -->
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextSecondary}"/>
    <Setter Property="Height" Value="{x:Static t:Sizes.NavItem}"/>
    <Setter Property="Margin" Value="{ui:Space 0,0,0,s1}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <ui:SquircleBorder x:Name="Bd" Background="Transparent" CornerRadius="{x:Static t:Corners.M}" Padding="{ui:Space s6,0}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ui:SquircleBorder x:Name="Marker" Width="3" Height="16" CornerRadius="{x:Static t:Corners.Pill}"
                                 Background="{DynamicResource AccentBrush}" Margin="{ui:Space -s4,0,s4,0}" Opacity="0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{x:Static t:FontStack.Icons}" FontSize="{x:Static t:IconSize.L}" VerticalAlignment="Center"
                           Margin="{ui:Space 0,0,s6,0}"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="{x:Static t:TypeRamp.Body}"/>
              </StackPanel>
            </Grid>
          </ui:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static t:Paint.HoverSubtle}"/>
              <Setter Property="Foreground" Value="{x:Static t:Paint.TextPrimary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{x:Static t:Paint.Raised}"/>
              <Setter TargetName="Marker" Property="Opacity" Value="1"/>
              <Setter Property="Foreground" Value="{x:Static t:Paint.TextPrimary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Titres : page (grand titre), sous-titre, groupe -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{x:Static t:FontStack.Display}"/>
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.LargeTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="{ui:Space 0,0,0,s3}"/>
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Body}"/>
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="{ui:Space 0,0,0,s10}"/>
  </Style>
  <Style x:Key="GroupTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextSecondary}"/>
    <Setter Property="Margin" Value="{ui:Space s2,s9,0,s4}"/>
  </Style>

  <!-- Carte d'un réglage : titre + description à gauche, contrôle à droite (à poser sur un ui:SquircleBorder) -->
  <Style x:Key="SettingCard" TargetType="Border">
    <Setter Property="Background" Value="{x:Static t:Paint.Card}"/>
    <Setter Property="BorderBrush" Value="{x:Static t:Paint.CardBorder}"/>
    <Setter Property="BorderThickness" Value="{x:Static t:Borders.Hairline}"/>
    <Setter Property="CornerRadius" Value="{x:Static t:Corners.L}"/>
    <Setter Property="Padding" Value="{ui:Space s9,s7}"/>
    <Setter Property="Margin" Value="{ui:Space 0,0,0,s3}"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Headline}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="CardDescription" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Footnote}"/>
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="{ui:Space 0,s1,0,0}"/>
  </Style>
  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Body}"/>
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextSecondary}"/>
    <Setter Property="MinWidth" Value="62"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="{ui:Space 0,0,s6,0}"/>
  </Style>

  <!-- Bouton secondaire -->
  <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
    <Setter Property="Background" Value="{x:Static t:Paint.Control}"/>
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Body}"/>
    <Setter Property="Height" Value="{x:Static t:Sizes.Button}"/>
    <Setter Property="Padding" Value="{ui:Space s8,0}"/>
    <Setter Property="Margin" Value="{ui:Space s8,0,0,0}"/>
  </Style>

  <!-- Curseur fin -->
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <ui:SquircleBorder Height="{x:Static t:Sizes.Bar}" CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource AccentBrush}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderRest" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse Width="{x:Static t:Sizes.SliderThumb}" Height="{x:Static t:Sizes.SliderThumb}" Fill="{x:Static t:Paint.White}"
                   Stroke="{x:Static t:Paint.ThumbStroke}" StrokeThickness="{x:Static t:Stroke.Hairline}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Champ de saisie (codes couleur, ville, ID…) -->
  <Style x:Key="HexBox" TargetType="TextBox">
    <Setter Property="Width" Value="92"/>
    <Setter Property="Height" Value="{x:Static t:Sizes.Button}"/>
    <Setter Property="FontFamily" Value="{x:Static t:FontStack.Mono}"/>
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Body}"/>
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{x:Static t:Paint.White}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MaxLength" Value="7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ui:SquircleBorder x:Name="Bd" Background="{x:Static t:Paint.Control}" BorderBrush="{x:Static t:Paint.Selected}"
                             BorderThickness="{x:Static t:Borders.Hairline}" CornerRadius="{x:Static t:Corners.S}" Padding="{ui:Space s4,0}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </ui:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Champ de la clé API (6D-3) : comme HexBox, mais les caractères sont cachés -->
  <Style x:Key="KeyBox" TargetType="PasswordBox">
    <Setter Property="Height" Value="{x:Static t:Sizes.Button}"/>
    <Setter Property="FontFamily" Value="{x:Static t:FontStack.Mono}"/>
    <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Body}"/>
    <Setter Property="Foreground" Value="{x:Static t:Paint.TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{x:Static t:Paint.White}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <ui:SquircleBorder x:Name="Bd" Background="{x:Static t:Paint.Control}" BorderBrush="{x:Static t:Paint.Selected}"
                             BorderThickness="{x:Static t:Borders.Hairline}" CornerRadius="{x:Static t:Corners.S}" Padding="{ui:Space s4,0}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </ui:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barre de défilement fine et sombre (s'applique à toute la fenêtre) -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="{x:Static t:Sizes.ScrollBar}"/>
    <Setter Property="MinWidth" Value="{x:Static t:Sizes.ScrollBar}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderRest}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderRest}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <ui:SquircleBorder x:Name="Bar" Width="{x:Static t:Sizes.ScrollThumb}" CornerRadius="{x:Static t:Corners.Pill}"
                                         Margin="{ui:Space 0,s2}" Background="{x:Static t:Paint.ScrollThumb}"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{x:Static t:Paint.ScrollThumbHover}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSlider" TargetType="Slider">
    <Setter Property="Width" Value="200"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="{x:Static t:Sizes.SwitchHeight}" Background="Transparent">
            <ui:SquircleBorder Height="{x:Static t:Sizes.Bar}" CornerRadius="{x:Static t:Corners.Pill}" Background="{x:Static t:Paint.Track}"
                               VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
