              <Button x:Name="DoNotDisturbButton" Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center"
                      Margin="{ui:Space s5,0,0,0}" Click="DoNotDisturb_Click"/>
            </Grid>
          </ui:SquircleBorder>
        </StackPanel>

