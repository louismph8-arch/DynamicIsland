            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.week.track}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.week.track.desc}"/>
              </StackPanel>
              <CheckBox x:Name="WeekTrackToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="WeekTrack_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <!-- Semaine affichée (navigation, totaux, graphiques), dessinée dans SettingsWindow.Week.cs -->
          <StackPanel x:Name="WeekContent"/>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.week.options}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.week.summary}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.week.summary.desc}"/>
              </StackPanel>
              <CheckBox x:Name="WeekSummaryToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="WeekSummary_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.week.clear}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.week.clear.desc}"/>
              </StackPanel>
              <Button x:Name="WeekClearButton" Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center"
                      Margin="{ui:Space s5,0,0,0}" Content="{ui:L settings.week.clear.button}" Click="WeekClear_Click"/>
            </Grid>
          </ui:SquircleBorder>
        </StackPanel>

        <!-- À propos -->        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="{ui:L settings.propos}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{ui:L settings.ile_dock_widgets_windows}"/>

          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Image x:Name="AboutLogo" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Grid.Column="1" Margin="{ui:Space s8,0,0,0}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="Opaline"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}"/>
              </StackPanel>
            </Grid>
          </ui:SquircleBorder>

          <ui:SquircleBorder x:Name="SafeModeBanner" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.safe.banner.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.safe.banner.description}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L safe.restart}" Click="RestartApp_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder x:Name="StoppedModulesCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.modules.stopped.title}"/>
                <TextBlock x:Name="StoppedModulesText" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L settings.modules.stopped.restart}" Click="RestartApp_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.help.group}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.feedback.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.feedback.desc}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}">
                <Button Style="{StaticResource SettingsButton}" Content="{ui:L settings.feedback.button}" Click="Feedback_Click"
                        Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Stretch"/>
                <Button Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,s3,0,0}" Content="{ui:L settings.news.button}" Click="WhatsNew_Click"
                        HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.report.title}"/>
                  <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.report.description}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                        Content="{ui:L settings.report.button}" Click="BugReport_Click"/>
              </Grid>
              <TextBlock x:Name="BugReportText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s4,0,0}" Visibility="Collapsed"/>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.backups.title}"/>
              <TextBlock x:Name="BackupsDescription" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
              <StackPanel x:Name="BackupList" Margin="{ui:Space 0,s4,0,0}"/>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.safe.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.safe.description}"/>
              </StackPanel>
              <Button x:Name="SafeModeButton" Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L settings.safe.button}" Click="SafeModeRestart_Click"/>
