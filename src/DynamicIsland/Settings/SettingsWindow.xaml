                  <TextBox x:Name="FriendsAddBox" Style="{StaticResource HexBox}" Width="150" MaxLength="12" KeyDown="FriendsAddBox_KeyDown"/>
                  <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Margin="{ui:Space s4,0,0,0}" Content="{ui:L settings.friends.add}" Click="FriendsAdd_Click"/>
                </Grid>
                <TextBlock x:Name="FriendsMessageText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s3,0,0}" Visibility="Collapsed"/>
              </StackPanel>
            </ui:SquircleBorder>

            <StackPanel x:Name="FriendsRequestsGroup">
              <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.friends.group.requests}"/>
              <ui:SquircleBorder Style="{StaticResource SettingCard}">
                <StackPanel x:Name="FriendsRequestsList"/>
              </ui:SquircleBorder>
            </StackPanel>

            <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.friends.list}"/>
            <ui:SquircleBorder x:Name="FriendsListCard" Style="{StaticResource SettingCard}">
              <StackPanel x:Name="FriendsList"/>
            </ui:SquircleBorder>

            <StackPanel x:Name="FriendsBlockedGroup">
              <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.friends.group.blocked}"/>
              <ui:SquircleBorder Style="{StaticResource SettingCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.friends.blocked.desc}"/>
                  <StackPanel x:Name="FriendsBlockedList" Margin="{ui:Space 0,s3,0,0}"/>
                </StackPanel>
              </ui:SquircleBorder>
            </StackPanel>
            </StackPanel>
            <Button Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="{ui:Space s2,s6,0,0}" Content="{ui:L settings.friends.leave}"
                    Click="FriendsLeave_Click"/>
          </StackPanel>
        </StackPanel>

        <!-- Automatisations (7D) : règles « Quand… alors… » et Ne pas déranger -->
