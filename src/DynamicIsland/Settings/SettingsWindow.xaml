              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.friends.add.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.friends.add.desc}"/>
