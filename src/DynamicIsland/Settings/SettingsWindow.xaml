          <StackPanel x:Name="AutomationRulesList" Margin="{ui:Space 0,s4,0,0}"/>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.dnd}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="DoNotDisturbText" Style="{StaticResource CardTitle}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.dnd.desc}"/>
