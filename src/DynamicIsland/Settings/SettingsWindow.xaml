<Window x:Class="DynamicIsland.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
        Title="{ui:L settings.parametres_opaline}"
        Width="920" Height="620" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Paint.Window}" Foreground="{DynamicResource Paint.TextPrimary}" FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <ResourceDictionary Source="SettingsStyles.xaml"/>
  </Window.Resources>
  <!-- Correctif 10 : plus de barre de titre Windows ; notre barre (déplacement, réduire, fermer), le Mica reste -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="{x:Static t:SettingsShape.TitleBar}" ResizeBorderThickness="6" GlassFrameThickness="-1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="{x:Static t:SettingsShape.TitleBarRow}"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===== Navigation ===== -->
    <Border x:Name="NavPanel" Grid.RowSpan="2" Background="{DynamicResource Paint.Sidebar}" BorderBrush="{DynamicResource Paint.Card}" BorderThickness="{x:Static t:Borders.RightHairline}">
      <DockPanel Margin="{ui:Space s7,s7,s7,s7}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{ui:Space s5,0,0,s5}">
          <Image x:Name="HeaderLogo" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="{ui:Space s6,0,0,0}" VerticalAlignment="Center">
            <TextBlock Text="Opaline" FontSize="{x:Static t:TypeRamp.Headline}" FontWeight="SemiBold"/>
            <TextBlock Text="{ui:L settings.parametres}" FontSize="{x:Static t:TypeRamp.Caption}" Foreground="{DynamicResource Paint.TextSecondary}"/>
          </StackPanel>
        </StackPanel>
        <!-- Recherche (correctif 11) : n'importe quel réglage, Ctrl+F -->
        <Grid DockPanel.Dock="Top" Margin="{ui:Space 0,0,0,s5}">
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}"
                   TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
          <TextBlock Text="{x:Static t:Icons.Search}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.M}" IsHitTestVisible="False"
                     Foreground="{DynamicResource Paint.TextTertiary}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"/>
          <TextBlock x:Name="SearchHint" Text="{ui:L settings.search.hint}" IsHitTestVisible="False" FontSize="{x:Static t:TypeRamp.Body}"
                     Foreground="{DynamicResource Paint.TextTertiary}" VerticalAlignment="Center" Margin="{ui:Space s14,0,0,0}"/>
          <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" AllowsTransparency="True"
                 StaysOpen="False" Width="{x:Static t:SettingsShape.SearchPopup}" PopupAnimation="Fade">
            <ui:SquircleBorder Background="{DynamicResource Paint.PopupBackground}" BorderBrush="{DynamicResource Paint.PopupBorder}" BorderThickness="{x:Static t:Borders.Hairline}"
                               CornerRadius="{x:Static t:Corners.L}" Padding="{ui:Space s3}" Margin="{ui:Space 0,s2,0,0}">
              <StackPanel x:Name="SearchResults"/>
            </ui:SquircleBorder>
          </Popup>
        </Grid>
        <!-- 12 pages : la liste défile (sans barre) si la fenêtre est vraiment trop basse -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Settings}" Content="{ui:L settings.general}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavAppearance" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Appearance}" Content="{ui:L settings.apparence}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavWallpaper" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Wallpaper}" Content="{ui:L settings.fond_ecran}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavIsland" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Island}" Content="{ui:L settings.ile}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavDock" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Dock}" Content="{ui:L settings.dock}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavWidgets" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Widgets}" Content="{ui:L settings.widgets}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavProfiles" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Profiles}" Content="{ui:L settings.profils}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSharing" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Share}" Content="{ui:L settings.partage}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavConnected" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Connected}" Content="{ui:L settings.connected}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavFriends" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Friends}" Content="{ui:L settings.friends.page}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavAutomations" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Automations}" Content="{ui:L settings.automations}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavWeek" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Week}" Content="{ui:L settings.week}" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="{x:Static t:Icons.Info}" Content="{ui:L settings.propos}" Checked="Nav_Checked"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===== Notre barre de titre : la fenêtre se déplace par là ; réduire / fermer ===== -->
    <!-- Bande de titre pleine (correctif « double croix ») : le contenu qui défile s'arrête net dessous, liseré en bas -->
    <Border x:Name="TitleBand" Grid.Column="1" Background="{DynamicResource Paint.Window}" BorderBrush="{DynamicResource Paint.Card}"
            BorderThickness="{x:Static t:Borders.BottomHairline}"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{ui:Space 0,0,s4,0}">
      <Button Style="{StaticResource CaptionButton}" Content="{x:Static t:Icons.Minus}" ToolTip="{ui:L settings.window.minimize}" Click="MinimizeWindow_Click"/>
      <Button Style="{StaticResource CaptionButton}" Content="{x:Static t:Icons.Close}" Tag="close" ToolTip="{ui:L settings.window.close}"
              Margin="{ui:Space s2,0,0,0}" Click="CloseWindow_Click"/>
    </StackPanel>

    <!-- ===== Contenu ===== -->
    <DockPanel Grid.Column="1" Grid.Row="1">
    <!-- Problème de réglages (correctif urgent 2) : jamais un interrupteur qui « ne fait rien » en silence -->
    <ui:SquircleBorder x:Name="SettingsAlert" DockPanel.Dock="Top" Visibility="Collapsed" Style="{StaticResource SettingCard}" MaxWidth="760"
                       Margin="{ui:Space s18,s2,s14,0}" Background="{x:Static t:Paint.TimerSoft}" BorderBrush="{x:Static t:Paint.Timer}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static t:Icons.Alert}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XL}"
                   Foreground="{x:Static t:Paint.Timer}" VerticalAlignment="Top" Margin="{ui:Space 0,s1,s6,0}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="SettingsAlertTitle" Style="{StaticResource CardTitle}" FontWeight="SemiBold"/>
          <TextBlock x:Name="SettingsAlertText" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}">
          <Button x:Name="SettingsAlertFolder" Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s3,0}"
                  Content="{ui:L settings.alert.folder}" Click="OpenSettingsFolder_Click"/>
          <Button x:Name="SettingsAlertAction" Style="{StaticResource SettingsButton}" Click="SettingsAlertAction_Click"/>
          <Button x:Name="SettingsAlertClose" Style="{StaticResource SettingsButton}" Margin="{ui:Space s3,0,0,0}"
                  Content="{ui:L settings.alert.close}" Click="SettingsAlertClose_Click"/>
        </StackPanel>
      </Grid>
    </ui:SquircleBorder>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="PagesHost" Margin="{ui:Space s18,s3,s14,s18}" MaxWidth="760">

        <!-- Général -->
        <StackPanel x:Name="GeneralPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="{ui:L settings.general}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{ui:L settings.demarrage_modules_opaline_tout}"/>

          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.lancer_demarrage_windows}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.opaline_ouvre_automatiquement_avec}"/>
              </StackPanel>
              <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="StartupToggle_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.language.group}"/>
          <RadioButton x:Name="LanguageAuto" Style="{StaticResource OptionCard}" GroupName="Language" Checked="Language_Checked"
                       Content="{ui:L settings.language.auto}" Tag="{ui:L settings.language.auto.description}"/>
          <RadioButton x:Name="LanguageFrench" Style="{StaticResource OptionCard}" GroupName="Language" Checked="Language_Checked"
                       Content="Français" Tag="{ui:L settings.language.french.description}"/>
          <RadioButton x:Name="LanguageEnglish" Style="{StaticResource OptionCard}" GroupName="Language" Checked="Language_Checked"
                       Content="English" Tag="{ui:L settings.language.english.description}"/>
          <ui:SquircleBorder x:Name="LanguageRestartCard" Style="{StaticResource SettingCard}" Visibility="Collapsed" Margin="{ui:Space 0,s4,0,s3}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{ui:L settings.language.restart.description}"/>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L settings.language.restart}" Click="RestartApp_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.modules}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.ile}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.pilule_haut_ecran_musique}"/>
              </StackPanel>
              <CheckBox x:Name="IslandEnabledToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.dock}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.desactive_barre_taches_windows}"/>
              </StackPanel>
              <CheckBox x:Name="DockEnabledToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.barre_menus_facon_macos}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.barre_menus_haut_ecran}"/>
                <TextBlock Style="{StaticResource CardDescription}"
                           Text="{ui:L settings.gauche_menu_app_verrouiller}"/>
              </StackPanel>
              <CheckBox x:Name="MenuBarToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.reserver_espace}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.fenetres_agrandies_arretent_sous}"/>
              </StackPanel>
              <CheckBox x:Name="MenuBarReserveToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.flou_acrylique_derriere_barre}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.vrai_flou_windows_11}"/>
              </StackPanel>
              <CheckBox x:Name="MenuBarBlurToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.palette_commandes}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.palette_commandes}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                           Text="{ui:L settings.raccourci_fait_sortir_barre}"/>
              </StackPanel>
              <CheckBox x:Name="PaletteToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.raccourci}"/>
                <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource HexBox}" Width="190" MaxLength="40" IsReadOnly="True"
                       FontFamily="{StaticResource UiFont}" Cursor="Hand" ToolTip="{ui:L settings.clique_ici_puis_appuie}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                       LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
              <Button Grid.Column="2" Style="{StaticResource SettingsButton}" Margin="{ui:Space s4,0,0,0}" Content="{ui:L settings.par_defaut}" Click="DefaultHotkey_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.notes.group}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.notes.hotkey.title}"/>
                <TextBlock x:Name="NoteHotkeyStatus" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBox x:Name="NoteHotkeyBox" Grid.Column="1" Style="{StaticResource HexBox}" Width="190" MaxLength="40" IsReadOnly="True"
                       FontFamily="{StaticResource UiFont}" Cursor="Hand" ToolTip="{ui:L settings.notes.hotkey.tip}"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                       LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
              <Button Grid.Column="2" Style="{StaticResource SettingsButton}" Margin="{ui:Space s4,0,0,0}" Content="{ui:L settings.notes.hotkey.suggest}" Click="DefaultNoteHotkey_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.notes.encrypt.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.notes.encrypt.description}"/>
              </StackPanel>
              <CheckBox x:Name="NotesEncryptToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="NotesEncryptToggle_Click"/>
            </Grid>
          </ui:SquircleBorder>
        </StackPanel>

        <!-- Apparence -->
        <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="{ui:L settings.apparence}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{ui:L settings.couleurs_transparence_animations_ile}"/>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.couleur_accent_celle_profil}" Margin="{ui:Space s2,0,0,s4}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <WrapPanel x:Name="AccentSwatches"/>
              <Grid Margin="{ui:Space 0,s7,0,0}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.personnalisee}"/>
                  <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.code_couleur_rrggbb_deux}"/>
                </StackPanel>
                <TextBox x:Name="AccentStartBox" Grid.Column="1" Style="{StaticResource HexBox}" KeyDown="AccentBox_KeyDown" LostFocus="AccentBox_LostFocus"/>
                <TextBlock Grid.Column="2" Text="→" Margin="{ui:Space s4,0}" VerticalAlignment="Center" Foreground="{DynamicResource Paint.TextSecondary}"/>
                <TextBox x:Name="AccentEndBox" Grid.Column="3" Style="{StaticResource HexBox}" KeyDown="AccentBox_KeyDown" LostFocus="AccentBox_LostFocus"/>
              </Grid>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.halo_neon}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.lueur_couleur_accent_autour}"/>
              </StackPanel>
              <TextBlock x:Name="GlowText" Grid.Column="1" Style="{StaticResource ValueText}"/>
              <Slider x:Name="GlowSlider" Grid.Column="2" Style="{StaticResource SettingsSlider}" VerticalAlignment="Center"
                      Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>
          <!-- Refonte O2 : thème d'Opaline (verre sombre / opale blanche / selon le soleil / comme Windows), bascule en douceur -->
          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.opal_theme.group}"/>
          <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.opal_theme.description}" TextWrapping="Wrap" Margin="{ui:Space 0,0,0,s2}"/>
          <RadioButton x:Name="OpalThemeDark" Style="{StaticResource OptionCard}" GroupName="OpalThemeMode" Checked="OpalTheme_Checked"
                       Content="{ui:L opal.theme.dark}" Tag="{ui:L opal.theme.dark.description}"/>
          <RadioButton x:Name="OpalThemeLight" Style="{StaticResource OptionCard}" GroupName="OpalThemeMode" Checked="OpalTheme_Checked"
                       Content="{ui:L opal.theme.light}" Tag="{ui:L opal.theme.light.description}"/>
          <RadioButton x:Name="OpalThemeAuto" Style="{StaticResource OptionCard}" GroupName="OpalThemeMode" Checked="OpalTheme_Checked"
                       Content="{ui:L opal.theme.auto}" Tag="{ui:L opal.theme.auto.description}"/>
          <RadioButton x:Name="OpalThemeWindows" Style="{StaticResource OptionCard}" GroupName="OpalThemeMode" Checked="OpalTheme_Checked"
                       Content="{ui:L opal.theme.windows}" Tag="{ui:L opal.theme.windows.description}"/>

          <!-- Refonte O1 : intensité du « verre opalin » (appliquée tout de suite à toute l'app) + la démo pour comparer -->
          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.opal.group}"/>
          <RadioButton x:Name="OpalDiscreet" Style="{StaticResource OptionCard}" GroupName="OpalStyle" Checked="OpalStyle_Checked"
                       Content="{ui:L opal.style.discreet}" Tag="{ui:L opal.style.discreet.description}"/>
          <RadioButton x:Name="OpalBalanced" Style="{StaticResource OptionCard}" GroupName="OpalStyle" Checked="OpalStyle_Checked"
                       Content="{ui:L opal.style.balanced}" Tag="{ui:L opal.style.balanced.description}"/>
          <RadioButton x:Name="OpalIntense" Style="{StaticResource OptionCard}" GroupName="OpalStyle" Checked="OpalStyle_Checked"
                       Content="{ui:L opal.style.intense}" Tag="{ui:L opal.style.intense.description}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.opal.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.opal.description}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s6,0,0,0}"
                      Content="{ui:L settings.opal.open}" Click="OpalDemo_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.couleurs_automatiques}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.couleurs_fond_ecran}"/>
                  <TextBlock Style="{StaticResource CardDescription}"
                             Text="{ui:L settings.accent_halo_prennent_couleurs}"/>
                </StackPanel>
                <CheckBox x:Name="WallpaperAccentToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
              </Grid>
              <StackPanel x:Name="WallpaperColorsRow" Orientation="Horizontal" Margin="{ui:Space 0,s5,0,0}" Visibility="Collapsed">
                <Ellipse x:Name="WallpaperStartDot" Width="{x:Static t:Sizes.ChoiceDot}" Height="{x:Static t:Sizes.ChoiceDot}"/>
                <Ellipse x:Name="WallpaperEndDot" Width="{x:Static t:Sizes.ChoiceDot}" Height="{x:Static t:Sizes.ChoiceDot}" Margin="{ui:Space s3,0,0,0}"/>
                <ui:SquircleBorder x:Name="WallpaperSurfaceDot" Width="{x:Static t:Sizes.ChoiceDot}" Height="{x:Static t:Sizes.ChoiceDot}" Margin="{ui:Space s3,0,0,0}"
                                   CornerRadius="{x:Static t:Corners.S}" BorderBrush="{DynamicResource Paint.PopupBorder}" BorderThickness="{x:Static t:Borders.Hairline}"/>
                <TextBlock x:Name="WallpaperColorsText" Style="{StaticResource CardDescription}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"/>
              </StackPanel>
              <!-- Option coupée = « Couleur fixe » (O2) : la couleur du profil, choisie à la main, ne bouge plus avec le fond -->
              <StackPanel x:Name="FixedColorRow" Orientation="Horizontal" Margin="{ui:Space 0,s5,0,0}">
                <Ellipse x:Name="FixedStartDot" Width="{x:Static t:Sizes.ChoiceDot}" Height="{x:Static t:Sizes.ChoiceDot}"/>
                <Ellipse x:Name="FixedEndDot" Width="{x:Static t:Sizes.ChoiceDot}" Height="{x:Static t:Sizes.ChoiceDot}" Margin="{ui:Space s3,0,0,0}"/>
                <TextBlock x:Name="FixedColorText" Style="{StaticResource CardDescription}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.teinter_ile_dock}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.avec_couleurs_fond_ecran}"/>
              </StackPanel>
              <CheckBox x:Name="WallpaperTintToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Setting_Changed"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.couleur_accent_windows}"/>
                <TextBlock Style="{StaticResource CardDescription}"
                           Text="{ui:L settings.windows_prend_couleur_app}"/>
