                  <Button Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.friends.copy_server}" Click="FriendsCopyWorker_Click"/>
                  <Button Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.friends.open_cloudflare}" Click="FriendsOpenCloudflare_Click"/>
                </WrapPanel>
              </StackPanel>
            </ui:SquircleBorder>

            <StackPanel x:Name="FriendsConnectedPanel">
            <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.friends.group.me}"/>
            <ui:SquircleBorder x:Name="FriendsMeCard" Style="{StaticResource SettingCard}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="FriendsCodeText" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.friends.code.desc}"/>
                  </StackPanel>
                  <Button x:Name="FriendsInviteButton" Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center"
                          Content="{ui:L settings.friends.invite}" Click="FriendsInvite_Click"/>
                </Grid>
                <Grid Margin="{ui:Space 0,s5,0,0}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource CardDescription}" VerticalAlignment="Center" Margin="{ui:Space 0,0,s4,0}" Text="{ui:L settings.friends.name}"/>
                  <TextBox x:Name="FriendsNameBox" Grid.Column="1" Style="{StaticResource HexBox}" Width="220" HorizontalAlignment="Left" MaxLength="32"
                           FontFamily="{StaticResource UiFont}" KeyDown="FriendsNameBox_KeyDown" LostFocus="FriendsNameBox_LostFocus"/>
                </Grid>
                <CheckBox x:Name="FriendsInvisibleToggle" Margin="{ui:Space 0,s5,0,0}" Foreground="{DynamicResource Paint.TextSecondary}"
                          Content="{ui:L settings.friends.invisible}" Click="FriendsOption_Click"/>
                <CheckBox x:Name="FriendsShareGameToggle" Margin="{ui:Space 0,s3,0,0}" Foreground="{DynamicResource Paint.TextSecondary}"
                          Content="{ui:L settings.friends.share_game}" Click="FriendsOption_Click"/>
                <CheckBox x:Name="FriendsNotifyToggle" Margin="{ui:Space 0,s3,0,0}" Foreground="{DynamicResource Paint.TextSecondary}"
                          Content="{ui:L settings.friends.notify}" Click="FriendsOption_Click"/>
                <CheckBox x:Name="FriendsMessagesToggle" Margin="{ui:Space 0,s3,0,0}" Foreground="{DynamicResource Paint.TextSecondary}"
                          Content="{ui:L settings.friends.messages}" Click="FriendsOption_Click"/>
              </StackPanel>
            </ui:SquircleBorder>

            <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.friends.group.add}"/>
