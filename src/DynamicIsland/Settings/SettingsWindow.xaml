                  <Button x:Name="AddPhoneButton" Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.remote.add}"
                          Background="{DynamicResource AccentGradientBrush}" Click="AddPhone_Click"/>
                  <Button x:Name="CancelPairingButton" Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.annuler}" Click="CancelPairing_Click"/>
                  <Button x:Name="NetworkSettingsButton" Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.remote.network}" Click="NetworkSettings_Click"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </ui:SquircleBorder>

          <ui:SquircleBorder x:Name="RemoteDevicesCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.remote.devices}"/>
              <TextBlock x:Name="RemoteNoDeviceText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.remote.devices.none}"/>
              <StackPanel x:Name="RemoteDeviceList" Margin="{ui:Space 0,s2,0,0}"/>
              <TextBlock x:Name="RemoteFullNote" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s3,0,0}"
                         Text="{ui:L settings.remote.full.note}"/>
            </StackPanel>
          </ui:SquircleBorder>

          <ui:SquircleBorder x:Name="WakeCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.wake}"/>
              <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.wake.desc}"/>
              <TextBlock x:Name="WakeInfoText" FontSize="{x:Static t:TypeRamp.Body}" TextWrapping="Wrap" Margin="{ui:Space 0,s4,0,0}"/>
              <TextBlock x:Name="WakeStateText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s2,0,0}"/>
              <WrapPanel Margin="{ui:Space 0,s5,0,0}">
                <Button x:Name="WakePrepareButton" Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.wake.prepare}"
                        Background="{DynamicResource AccentGradientBrush}" Click="WakePrepare_Click"/>
                <Button x:Name="WakeUndoButton" Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.wake.undo}" Click="WakeUndo_Click"/>
              </WrapPanel>
              <TextBlock x:Name="WakeMessageText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s3,0,0}" Visibility="Collapsed"/>
            </StackPanel>
          </ui:SquircleBorder>

          <ui:SquircleBorder x:Name="RemoteFirewallCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.remote.firewall.left}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.remote.firewall.left.desc}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Content="{ui:L settings.remote.firewall.remove}" Click="RemoveFirewall_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space s2,s2,s2,0}" Text="{ui:L settings.remote.note}"/>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.rgb}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.rgb.toggle}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.rgb.toggle.desc}"/>
              </StackPanel>
              <CheckBox x:Name="RgbToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Rgb_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder x:Name="RgbOptionsCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="RgbSwatch" Width="14" Height="14" VerticalAlignment="Center" Margin="{ui:Space 0,0,s4,0}"/>
                <TextBlock x:Name="RgbLogitechText" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock x:Name="RgbOpenRgbText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s2,0,0}"/>
              <CheckBox x:Name="RgbMusicToggle" Margin="{ui:Space 0,s6,0,0}" Foreground="{StaticResource TextSecondary}"
                        Content="{ui:L settings.rgb.music}" Click="Rgb_Click"/>
              <CheckBox x:Name="RgbGamesToggle" Margin="{ui:Space 0,s3,0,0}" Foreground="{StaticResource TextSecondary}"
                        Content="{ui:L settings.rgb.games}" Click="Rgb_Click"/>
              <Button Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="{ui:Space 0,s5,0,0}" Content="{ui:L settings.rgb.retry}" Click="RgbRetry_Click"/>
            </StackPanel>
          </ui:SquircleBorder>

          <!-- Amis en ligne (6D-4) -->
          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.friends}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.friends.toggle}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.friends.toggle.desc}"/>
              </StackPanel>
              <CheckBox x:Name="FriendsToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Click="Friends_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <StackPanel x:Name="FriendsPanel" Visibility="Collapsed">
            <ui:SquircleBorder Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.friends.server}"/>
                <TextBlock x:Name="FriendsServerStatus" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
                <Grid Margin="{ui:Space 0,s4,0,0}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="FriendsServerBox" Style="{StaticResource HexBox}" Width="NaN" MaxLength="200" FontFamily="{StaticResource UiFont}"
                           KeyDown="FriendsServerBox_KeyDown"/>
                  <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Margin="{ui:Space s4,0,0,0}" Content="{ui:L settings.friends.server.save}"
                          Click="FriendsServerSave_Click"/>
                </Grid>
                <TextBlock x:Name="FriendsGuideText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s5,0,0}"
                           Text="{ui:L settings.friends.guide}"/>
                <WrapPanel Margin="{ui:Space 0,s4,0,0}">
                  <Button Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.friends.copy_server}" Click="FriendsCopyWorker_Click"/>
                  <Button Style="{StaticResource SettingsButton}" Margin="{ui:Space 0,0,s4,0}" Content="{ui:L settings.friends.open_cloudflare}" Click="FriendsOpenCloudflare_Click"/>
                </WrapPanel>
              </StackPanel>
            </ui:SquircleBorder>

            <ui:SquircleBorder x:Name="FriendsMeCard" Style="{StaticResource SettingCard}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="FriendsCodeText" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.friends.code.desc}"/>
                  </StackPanel>
                  <Button x:Name="FriendsInviteButton" Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center"
                          Content="{ui:L settings.friends.invite}" Click="FriendsInvite_Click"/>
                </Grid>
                <Grid Margin="{ui:Space 0,s5,0,0}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource CardDescription}" VerticalAlignment="Center" Margin="{ui:Space 0,0,s4,0}" Text="{ui:L settings.friends.name}"/>
                  <TextBox x:Name="FriendsNameBox" Grid.Column="1" Style="{StaticResource HexBox}" Width="220" HorizontalAlignment="Left" MaxLength="32"
                           FontFamily="{StaticResource UiFont}" KeyDown="FriendsNameBox_KeyDown" LostFocus="FriendsNameBox_LostFocus"/>
                </Grid>
                <CheckBox x:Name="FriendsInvisibleToggle" Margin="{ui:Space 0,s5,0,0}" Foreground="{StaticResource TextSecondary}"
                          Content="{ui:L settings.friends.invisible}" Click="FriendsOption_Click"/>
                <CheckBox x:Name="FriendsShareGameToggle" Margin="{ui:Space 0,s3,0,0}" Foreground="{StaticResource TextSecondary}"
                          Content="{ui:L settings.friends.share_game}" Click="FriendsOption_Click"/>
                <CheckBox x:Name="FriendsNotifyToggle" Margin="{ui:Space 0,s3,0,0}" Foreground="{StaticResource TextSecondary}"
                          Content="{ui:L settings.friends.notify}" Click="FriendsOption_Click"/>
              </StackPanel>
            </ui:SquircleBorder>

            <ui:SquircleBorder x:Name="FriendsListCard" Style="{StaticResource SettingCard}">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.friends.list}"/>
                <Grid Margin="{ui:Space 0,s4,0,0}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBox x:Name="FriendsAddBox" Style="{StaticResource HexBox}" Width="150" MaxLength="12" KeyDown="FriendsAddBox_KeyDown"/>
                  <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Margin="{ui:Space s4,0,0,0}" Content="{ui:L settings.friends.add}" Click="FriendsAdd_Click"/>
                </Grid>
                <TextBlock x:Name="FriendsMessageText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s3,0,0}" Visibility="Collapsed"/>
                <StackPanel x:Name="FriendsList" Margin="{ui:Space 0,s3,0,0}"/>
              </StackPanel>
            </ui:SquircleBorder>
            <Button Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="{ui:Space s2,s2,0,0}" Content="{ui:L settings.friends.leave}"
                    Click="FriendsLeave_Click"/>
          </StackPanel>
        </StackPanel>

        <!-- À propos -->
        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="{ui:L settings.propos}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{ui:L settings.ile_dock_widgets_windows}"/>

          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Image x:Name="AboutLogo" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Grid.Column="1" Margin="{ui:Space s8,0,0,0}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="Opaline"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}"/>
              </StackPanel>
            </Grid>
          </ui:SquircleBorder>

          <ui:SquircleBorder x:Name="SafeModeBanner" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.safe.banner.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.safe.banner.description}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L safe.restart}" Click="RestartApp_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder x:Name="StoppedModulesCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.modules.stopped.title}"/>
                <TextBlock x:Name="StoppedModulesText" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L settings.modules.stopped.restart}" Click="RestartApp_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <TextBlock Style="{StaticResource GroupTitle}" Text="{ui:L settings.help.group}"/>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.report.title}"/>
                  <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.report.description}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                        Content="{ui:L settings.report.button}" Click="BugReport_Click"/>
              </Grid>
              <TextBlock x:Name="BugReportText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="{ui:Space 0,s4,0,0}" Visibility="Collapsed"/>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.backups.title}"/>
              <TextBlock x:Name="BackupsDescription" Style="{StaticResource CardDescription}" TextWrapping="Wrap"/>
              <StackPanel x:Name="BackupList" Margin="{ui:Space 0,s4,0,0}"/>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.safe.title}"/>
                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="{ui:L settings.safe.description}"/>
              </StackPanel>
              <Button x:Name="SafeModeButton" Grid.Column="1" Style="{StaticResource SettingsButton}" VerticalAlignment="Center" Margin="{ui:Space s5,0,0,0}"
                      Content="{ui:L settings.safe.button}" Click="SafeModeRestart_Click"/>
            </Grid>
          </ui:SquircleBorder>

          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.assistant_bienvenue}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.presentation_premier_lancement_profil}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Content="{ui:L settings.revoir}" VerticalAlignment="Center" Click="Welcome_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.fichiers_reglages}"/>
                <TextBlock x:Name="SettingsPathText" Style="{StaticResource CardDescription}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Content="{ui:L settings.ouvrir_dossier}" VerticalAlignment="Center" Click="OpenSettingsFolder_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.journal_erreurs}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.utile_si_quelque_chose}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Content="{ui:L settings.ouvrir_journal}" VerticalAlignment="Center" Click="OpenLog_Click"/>
            </Grid>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.composants_libres}"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.managedshell_zone_notification_apache}"/>
            </StackPanel>
          </ui:SquircleBorder>
          <ui:SquircleBorder Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{ui:L settings.quitter_opaline}"/>
                <TextBlock Style="{StaticResource CardDescription}" Text="{ui:L settings.barre_taches_windows_revient}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SettingsButton}" Content="{ui:L settings.quitter}" VerticalAlignment="Center" Click="Quit_Click"/>
            </Grid>
          </ui:SquircleBorder>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
