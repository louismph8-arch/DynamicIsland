<Window x:Class="DynamicIsland.Dock.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
        Title="Dynamic Island — Aperçu"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="{DynamicResource Paint.Preview}" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Paint.TextPrimary}">

  <!-- Fenêtre NON transparente : les miniatures DWM ne s'affichent pas sur une fenêtre « layered ».
       Coins arrondis et bordure fournis par Windows 11 (DWM) : c'est le seul encadré. Le nom de l'appli n'est pas répété
       (l'étiquette du dock le montre déjà) : chaque carte = titre de la fenêtre + « × », puis sa miniature. -->
  <StackPanel x:Name="Slots" Orientation="Horizontal" Margin="{ui:Space s2}"/>
</Window>
