<Window x:Class="DynamicIsland.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
        Title="Dynamic Island — Dock"
        Width="1920" Height="170" Left="0" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}">

  <!-- Fenêtre transparente sur toute la largeur de son écran : seul le dock capte la souris. Les alignements « Bottom »
       passent à « Top » quand le dock est en haut de l'écran (ApplyAppearance). -->
  <Grid x:Name="Root">
    <Grid x:Name="DockRoot" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="{ui:Space 0,0,0,s4}"
          MouseMove="DockRoot_MouseMove" MouseLeave="DockRoot_MouseLeave"
          MouseLeftButtonDown="DockRoot_MouseLeftButtonDown" MouseLeftButtonUp="DockRoot_MouseLeftButtonUp"
          LostMouseCapture="DockRoot_LostMouseCapture" MouseRightButtonUp="DockRoot_MouseRightButtonUp">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="DockShift"/>
      </Grid.RenderTransform>

      <!-- L'ombre est sur ce conteneur : l'effet du fond lui-même est le verre liquide. -->
      <Grid x:Name="DockShell" VerticalAlignment="Bottom">
        <Grid.Effect>
          <DropShadowEffect x:Name="DockShadow" Direction="{x:Static t:Shadows.Direction}" RenderingBias="Performance"/>
        </Grid.Effect>
        <ui:SquircleBorder x:Name="DockBackground" Height="68" VerticalAlignment="Bottom" CornerRadius="{x:Static t:Corners.Window}"
                Background="{DynamicResource IslandBrush}" BorderBrush="{x:Static t:Paint.Control}" BorderThickness="{x:Static t:Borders.Hairline}"/>
      </Grid>

      <StackPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="{ui:Space s5,0}"/>

      <!-- Mode barre : recherche collée à gauche, icônes d'arrière-plan collées à droite -->
      <StackPanel x:Name="EdgeLeft" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="{ui:Space s5,0,0,0}"/>
      <StackPanel x:Name="EdgeRight" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="{ui:Space 0,0,s3,0}"/>
    </Grid>

    <!-- Nom de l'appli au survol -->
    <Canvas IsHitTestVisible="False">
      <ui:SquircleBorder x:Name="NameLabel" Opacity="0" Background="{x:Static t:Paint.LabelBackground}" CornerRadius="{x:Static t:Corners.S}" Padding="{ui:Space s5,s2}"
              BorderBrush="{x:Static t:Paint.Control}" BorderThickness="{x:Static t:Borders.Hairline}">
        <TextBlock x:Name="NameText" FontSize="{x:Static t:TypeRamp.Callout}" FontWeight="SemiBold"/>
      </ui:SquircleBorder>
    </Canvas>
  </Grid>
</Window>
