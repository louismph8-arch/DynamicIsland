<UserControl x:Class="DynamicIsland.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
             Width="{x:Static t:IslandShape.ContentWidth}" Height="{x:Static t:IslandShape.MusicContentHeight}">
  <Grid>
    <Grid x:Name="PlayerPanel" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ui:SquircleBorder x:Name="CoverBorder" Width="{x:Static t:Sizes.Cover}" Height="{x:Static t:Sizes.Cover}" CornerRadius="{x:Static t:Corners.XXL}" VerticalAlignment="Center"
              Background="{StaticResource SurfaceBrush}" RenderOptions.BitmapScalingMode="HighQuality">
        <TextBlock x:Name="CoverPlaceholder" Text="{x:Static t:Icons.Music}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.Huge}"
                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </ui:SquircleBorder>

      <Grid Grid.Column="1" Margin="{ui:Space s9,s2,0,0}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="{x:Static t:TypeRamp.Title3}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ArtistText" Grid.Row="1" Margin="{ui:Space 0,px,0,0}" FontSize="{x:Static t:TypeRamp.Callout}"
                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>

        <Grid x:Name="ProgressPanel" Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="34"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" FontSize="{x:Static t:TypeRamp.Caption2}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
          <ui:SquircleBorder x:Name="ProgressTrack" Grid.Column="1" Height="4" CornerRadius="{x:Static t:Corners.Pill}" Margin="{ui:Space s2,0}"
                  Background="{x:Static t:Paint.Selected}" VerticalAlignment="Center">
            <ui:SquircleBorder x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="{x:Static t:Corners.Pill}" Background="{x:Static t:Paint.White}"/>
          </ui:SquircleBorder>
          <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="{x:Static t:TypeRamp.Caption2}" Foreground="{StaticResource TextTertiary}"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{ui:Space 0,s3,0,0}">
          <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="{x:Static t:Icons.Previous}" Click="Previous_Click"/>
          <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="{ui:Space s8,0}" Content="{x:Static t:Icons.Play}" Click="PlayPause_Click"/>
          <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="{x:Static t:Icons.Next}" Click="Next_Click"/>
        </StackPanel>
      </Grid>

      <!-- Volume de l'appli qui joue (sa session audio), sans toucher au volume de Windows. -->
      <Grid x:Name="AppVolumeRow" Grid.Row="1" Grid.ColumnSpan="2" Margin="{ui:Space 0,s5,0,0}" Background="{x:Static t:Paint.HitTarget}"
            ToolTip="{ui:L music.volume_appli_joue_musique}" ToolTipService.ShowOnDisabled="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="AppVolumeIcon" Text="{x:Static t:Icons.VolumeHigh}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.M}"
                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
        <ui:LineSlider x:Name="AppVolumeSlider" Grid.Column="1" Margin="{ui:Space s5,0}" VerticalAlignment="Center"/>
        <TextBlock x:Name="AppVolumeText" Grid.Column="2" MinWidth="{x:Static t:Sizes.SoftButton}" TextAlignment="Right"
                   FontSize="{x:Static t:TypeRamp.Caption2}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
      </Grid>
    </Grid>

    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="{x:Static t:Icons.Music}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XXL}"
                 Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center"/>
      <TextBlock Text="{ui:L music.aucune_lecture_cours}" FontSize="{x:Static t:TypeRamp.Headline}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{ui:Space 0,s5,0,0}"/>
      <TextBlock Text="{ui:L music.lance_spotify_video_youtube}" FontSize="{x:Static t:TypeRamp.Footnote}" Foreground="{StaticResource TextSecondary}"
                 HorizontalAlignment="Center" Margin="{ui:Space 0,s1,0,0}"/>
    </StackPanel>
  </Grid>
</UserControl>
