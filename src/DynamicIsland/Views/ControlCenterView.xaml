<UserControl x:Class="DynamicIsland.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Width="{x:Static t:IslandShape.ContentWidth}" Height="170">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="128"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="112"/>
    </Grid.ColumnDefinitions>

    <StackPanel VerticalAlignment="Center" Margin="{ui:Space 0,0,s6,0}">
      <controls:FillSlider x:Name="VolumeSlider" Label="Volume" Icon="{x:Static t:Icons.VolumeHigh}"/>
      <controls:FillSlider x:Name="BrightnessSlider" Label="Luminosité" Icon="{x:Static t:Icons.Brightness}" Margin="{ui:Space 0,s6,0,0}"/>
    </StackPanel>

    <ToggleButton x:Name="DarkToggle" Grid.Column="1" Style="{StaticResource TileToggle}" Click="DarkToggle_Click">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static t:Icons.DarkMode}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XXL}" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="1" Text="{ui:L controls.mode_sombre}" FontSize="{x:Static t:TypeRamp.Callout}" FontWeight="SemiBold"/>
        <TextBlock x:Name="DarkStateText" Grid.Row="2" FontSize="{x:Static t:TypeRamp.Caption}" Opacity="{x:Static t:Interaction.SecondaryTextOpacity}" Margin="{ui:Space 0,px,0,0}"/>
      </Grid>
    </ToggleButton>

    <!-- Profils : un clic change les apps du dock, la couleur d'accent et le fond d'écran -->
    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="{ui:Space 0,s6,0,0}" VerticalAlignment="Top"
                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="Profiles_PreviewMouseWheel">
      <StackPanel x:Name="ProfilesPanel" Orientation="Horizontal"/>
    </ScrollViewer>
  </Grid>
</UserControl>
