<UserControl x:Class="DynamicIsland.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
             Width="{x:Static t:IslandShape.ContentWidth}" Height="128">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Salon vocal Discord : nom + nombre de présents -->
    <StackPanel x:Name="Header" Orientation="Horizontal" Margin="{ui:Space s1,0,0,s4}">
      <TextBlock Text="{x:Static t:Icons.Voice}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.M}" VerticalAlignment="Center"
                 Foreground="{DynamicResource AccentGradientBrush}"/>
      <TextBlock x:Name="ChannelText" FontSize="{x:Static t:TypeRamp.Body}" FontWeight="SemiBold" Margin="{ui:Space s4,0,0,0}" VerticalAlignment="Center"
                 MaxWidth="260" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="CountText" FontSize="{x:Static t:TypeRamp.Footnote}" Foreground="{StaticResource TextSecondary}" Margin="{ui:Space s4,0,0,0}" VerticalAlignment="Center"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="MembersPanel"/>
    </ScrollViewer>

    <StackPanel x:Name="EmptyPanel" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="{x:Static t:Icons.Voice}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XXL}" Foreground="{StaticResource TextTertiary}"
                 HorizontalAlignment="Center"/>
      <TextBlock x:Name="EmptyTitle" FontSize="{x:Static t:TypeRamp.Headline}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{ui:Space 0,s4,0,0}"/>
      <TextBlock x:Name="EmptyText" FontSize="{x:Static t:TypeRamp.Footnote}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="{ui:Space 0,s1,0,0}"/>
    </StackPanel>
  </Grid>
</UserControl>
