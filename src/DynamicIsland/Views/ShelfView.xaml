<UserControl x:Class="DynamicIsland.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
             Width="{x:Static t:IslandShape.ContentWidth}" Height="128">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Fichiers (défilement horizontal à la molette) -->
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="Scroller_PreviewMouseWheel">
      <StackPanel x:Name="Tiles" Orientation="Horizontal"/>
    </ScrollViewer>

    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="{x:Static t:Icons.Shelf}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XXL}" Foreground="{StaticResource TextTertiary}"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{ui:L shelf.etagere_vide}" FontSize="{x:Static t:TypeRamp.Headline}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{ui:Space 0,s4,0,0}"/>
      <TextBlock Text="{ui:L shelf.glisse_fichiers_ile_garder}" FontSize="{x:Static t:TypeRamp.Footnote}"
                 Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="{ui:Space 0,s1,0,0}"/>
    </StackPanel>

    <!-- Zone de dépôt (pendant qu'on glisse des fichiers sur l'île) -->
    <ui:SquircleBorder x:Name="DropHint" Grid.RowSpan="2" CornerRadius="{x:Static t:Corners.XL}" BorderThickness="{x:Static t:Borders.Focus}" BorderBrush="{DynamicResource AccentBrush}"
            Background="{x:Static t:Paint.Card}" Opacity="0" IsHitTestVisible="False">
      <TextBlock Text="{ui:L shelf.depose_garder_etagere}" FontSize="{x:Static t:TypeRamp.Body}" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </ui:SquircleBorder>

    <Grid x:Name="Footer" Grid.Row="1" Margin="{ui:Space s1,s2,0,0}">
      <TextBlock x:Name="CountText" FontSize="{x:Static t:TypeRamp.Caption}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:SquircleBorder x:Name="DragAllHandle" CornerRadius="{x:Static t:Corners.Pill}" Height="22" Padding="{ui:Space s5,0}" Background="{StaticResource SurfaceBrush}"
                Cursor="SizeAll" MouseLeftButtonDown="DragAll_MouseDown" MouseMove="DragAll_MouseMove">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{x:Static t:Icons.Move}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.S}" VerticalAlignment="Center" Margin="{ui:Space 0,px,s3,0}"/>
            <TextBlock Text="{ui:L shelf.tout_glisser}" FontSize="{x:Static t:TypeRamp.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </ui:SquircleBorder>
        <Button Style="{StaticResource ChipButton}" Height="22" Margin="{ui:Space s3,0,0,0}" Content="{ui:L shelf.tout_vider}" Click="ClearAll_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
