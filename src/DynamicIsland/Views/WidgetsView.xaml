<UserControl x:Class="DynamicIsland.Views.WidgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
             Width="{x:Static t:IslandShape.ContentWidth}" Height="128">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{x:Static t:Paint.Surface}"/>
      <Setter Property="CornerRadius" Value="{x:Static t:Corners.XL}"/>
      <Setter Property="Padding" Value="{ui:Space s6,s4}"/>
      <Setter Property="Margin" Value="{ui:Space 0,0,s3,s3}"/>
    </Style>
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Caption}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{x:Static t:TypeRamp.Headline}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="TileBar" TargetType="Border">
      <Setter Property="Height" Value="{x:Static t:Sizes.Bar}"/>
      <Setter Property="CornerRadius" Value="{x:Static t:Corners.Pill}"/>
      <Setter Property="Background" Value="{x:Static t:Paint.Selected}"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid x:Name="ContentGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Météo -->
      <ui:SquircleBorder x:Name="WeatherTile" Style="{StaticResource Tile}" Width="140" Margin="{ui:Space 0,0,s3,0}" Padding="{ui:Space s6,s5}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="WeatherCity" Style="{StaticResource TileLabel}" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="WeatherSymbol" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:TypeRamp.Title1}" VerticalAlignment="Center"/>
            <TextBlock x:Name="WeatherTemp" FontFamily="{StaticResource DisplayFont}" FontSize="{x:Static t:TypeRamp.Display}" FontWeight="Light"
                       Margin="{ui:Space s3,0,0,0}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="WeatherDescription" Grid.Row="2" FontSize="{x:Static t:TypeRamp.Footnote}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="WeatherRange" Grid.Row="3" FontSize="{x:Static t:TypeRamp.Caption}" Foreground="{StaticResource TextSecondary}"/>
        </Grid>
      </ui:SquircleBorder>

      <!-- CPU, RAM, GPU, réseau (les tuiles désactivées sont repliées) -->
      <UniformGrid x:Name="StatTiles" Grid.Column="1" Columns="2" Margin="{ui:Space 0,0,-s3,-s3}">
        <ui:SquircleBorder x:Name="CpuTile" Style="{StaticResource Tile}">
          <Grid>
            <TextBlock Style="{StaticResource TileLabel}" Text="CPU"/>
            <TextBlock x:Name="CpuValue" Style="{StaticResource TileValue}" Text="…"/>
            <ui:SquircleBorder Style="{StaticResource TileBar}">
              <ui:SquircleBorder x:Name="CpuFill" CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
              </ui:SquircleBorder>
            </ui:SquircleBorder>
          </Grid>
        </ui:SquircleBorder>
        <ui:SquircleBorder x:Name="RamTile" Style="{StaticResource Tile}">
          <Grid>
            <TextBlock Style="{StaticResource TileLabel}" Text="RAM"/>
            <TextBlock x:Name="RamValue" Style="{StaticResource TileValue}" Text="…"/>
            <ui:SquircleBorder Style="{StaticResource TileBar}">
              <ui:SquircleBorder x:Name="RamFill" CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
              </ui:SquircleBorder>
            </ui:SquircleBorder>
          </Grid>
        </ui:SquircleBorder>
        <ui:SquircleBorder x:Name="GpuTile" Style="{StaticResource Tile}">
          <Grid>
            <TextBlock Style="{StaticResource TileLabel}" Text="GPU"/>
            <TextBlock x:Name="GpuValue" Style="{StaticResource TileValue}" Text="…"/>
            <ui:SquircleBorder Style="{StaticResource TileBar}">
              <ui:SquircleBorder x:Name="GpuFill" CornerRadius="{x:Static t:Corners.Pill}" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
              </ui:SquircleBorder>
            </ui:SquircleBorder>
          </Grid>
        </ui:SquircleBorder>
        <ui:SquircleBorder x:Name="NetworkTile" Style="{StaticResource Tile}">
          <Grid>
            <TextBlock Style="{StaticResource TileLabel}" Text="{ui:L widgets.reseau}"/>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock x:Name="DownloadValue" FontSize="{x:Static t:TypeRamp.Footnote}" FontWeight="SemiBold" Text="↓ …"/>
              <TextBlock x:Name="UploadValue" FontSize="{x:Static t:TypeRamp.Footnote}" Foreground="{StaticResource TextSecondary}" Text="↑ …"/>
            </StackPanel>
          </Grid>
        </ui:SquircleBorder>
      </UniformGrid>
    </Grid>

    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="{x:Static t:Icons.Widgets}" FontFamily="{StaticResource IconFont}" FontSize="{x:Static t:IconSize.XXL}" Foreground="{StaticResource TextTertiary}"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{ui:L widgets.aucun_widget_active}" FontSize="{x:Static t:TypeRamp.Headline}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{ui:Space 0,s4,0,0}"/>
      <TextBlock Text="{ui:L widgets.active_parametres_widgets}" FontSize="{x:Static t:TypeRamp.Footnote}" Foreground="{StaticResource TextSecondary}"
                 HorizontalAlignment="Center" Margin="{ui:Space 0,s1,0,0}"/>
    </StackPanel>
  </Grid>
</UserControl>
