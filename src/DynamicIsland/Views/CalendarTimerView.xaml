<UserControl x:Class="DynamicIsland.Views.CalendarTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:DynamicIsland.Themes"
        xmlns:ui="clr-namespace:DynamicIsland.Controls"
             Width="454" Height="194">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216"/>
      <ColumnDefinition Width="33"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Calendrier du mois -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="26"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Clic sur le mois = retour à aujourd'hui -->
      <Button Style="{StaticResource RoundButton}" HorizontalAlignment="Left" Height="26" Padding="{ui:Space s3,0}" Click="Month_Click">
        <TextBlock x:Name="MonthText" FontSize="{x:Static t:TypeRamp.Headline}" FontWeight="SemiBold"/>
      </Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SmallIconButton}" Content="{x:Static t:Icons.ChevronLeft}" Click="PreviousMonth_Click"/>
        <Button Style="{StaticResource SmallIconButton}" Content="{x:Static t:Icons.ChevronRight}" Click="NextMonth_Click"/>
      </StackPanel>

      <UniformGrid x:Name="DayNames" Grid.Row="1" Columns="7"/>
      <UniformGrid x:Name="DaysGrid" Grid.Row="2" Columns="7" Rows="6"/>
    </Grid>

    <Border Grid.Column="1" Width="1" Margin="{ui:Space 0,s2}" HorizontalAlignment="Center" Background="{StaticResource DividerBrush}"/>

    <!-- Minuteur -->
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
      <TextBlock x:Name="PhaseText" Text="{ui:L calendar.minuteur}" FontSize="{x:Static t:TypeRamp.Caption2}" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}"
                 HorizontalAlignment="Center"/>

      <Grid Margin="{ui:Space 0,s1,0,0}">
        <Button Style="{StaticResource SmallIconButton}" HorizontalAlignment="Left" Content="{x:Static t:Icons.Minus}" Click="Minus_Click"/>
        <TextBlock x:Name="TimerText" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                   FontSize="{x:Static t:TypeRamp.Hero}" FontWeight="Light" Text="05:00"/>
        <Button Style="{StaticResource SmallIconButton}" HorizontalAlignment="Right" Content="{x:Static t:Icons.Plus}" Click="Plus_Click"/>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{ui:Space 0,s3,0,0}">
        <Button Style="{StaticResource ChipButton}" Content="1 min" Tag="1" Click="Preset_Click"/>
        <Button Style="{StaticResource ChipButton}" Content="5 min" Tag="5" Click="Preset_Click" Margin="{ui:Space s2,0,0,0}"/>
        <Button Style="{StaticResource ChipButton}" Content="10 min" Tag="10" Click="Preset_Click" Margin="{ui:Space s2,0,0,0}"/>
        <Button Style="{StaticResource ChipButton}" Content="{ui:L calendar.pomodoro}" Tag="pomodoro" Click="Preset_Click" Margin="{ui:Space s2,0,0,0}"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{ui:Space 0,s6,0,0}">
        <Button x:Name="StartButton" Style="{StaticResource SoftButton}" Width="112" Content="{ui:L calendar.demarrer}" Click="Start_Click"/>
        <Button x:Name="ResetButton" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="{x:Static t:TypeRamp.Body}"
                Margin="{ui:Space s4,0,0,0}" Content="{x:Static t:Icons.Reset}" Click="Reset_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
