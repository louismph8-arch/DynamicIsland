{
  "format": 1,
  "id": "compteur-bitcoin",
  "name": "Compteur Bitcoin",
  "author": "Opaline",
  "version": "1.0",
  "description": "Le cours du Bitcoin en dollars et en euros, d'après l'API publique gratuite de CoinGecko (sans clé).",
  "size": { "width": 280, "height": 150 },
  "background": "card",
  "source": {
    "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,eur&include_24hr_change=true",
    "every": 10,
    "fields": {
      "usd": "$.bitcoin.usd",
      "eur": "$.bitcoin.eur",
      "change": "$.bitcoin.usd_24h_change"
    }
  },
  "root": {
    "type": "stack",
    "gap": 6,
    "children": [
      {
        "type": "stack",
        "direction": "horizontal",
        "gap": 8,
        "children": [
          { "type": "icon", "name": "bitcoin", "size": "xl", "color": "#F7931A" },
          { "type": "text", "text": "Bitcoin", "size": "headline", "weight": "semibold" }
        ]
      },
      { "type": "text", "text": "{web.usd:n0} $", "size": "display", "weight": "light", "font": "numbers" },
      { "type": "text", "text": "{web.eur:n0} € · 24 h : {web.change:0.00} %", "size": "footnote", "color": "secondary" },
      { "type": "text", "text": "CoinGecko", "size": "caption2", "color": "tertiary" }
    ]
  }
}
